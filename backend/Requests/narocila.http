@baseUrl = http://localhost:5176
@vrstaStoritveId = 1

### Aktivne storitve
# @prompt accessToken Prilepi dostopni žeton naročnika
GET {{baseUrl}}/api/vrste-storitev/aktivne
Authorization: Bearer {{accessToken}}
Accept: application/json

### Oddaja naročila 
# @prompt accessToken Prilepi dostopni žeton naročnika
POST {{baseUrl}}/api/narocila
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "vrstaStoritveId": {{vrstaStoritveId}},
  "opisDela": "Izkop za pripravo temeljev garaže.",
  "lokacija": "Gorišnica",
  "zeleniTermin": "2026-11-10T08:00:00+01:00"
}

### Seznam dostopnih naročil
# @prompt accessToken
GET {{baseUrl}}/api/narocila
Authorization: Bearer {{accessToken}}
Accept: application/json


### Potrditev naročila - organizator
# @prompt accessToken
POST {{baseUrl}}/api/narocila/1/potrditev
Authorization: Bearer {{accessToken}}

### Zavrnitev naročila
# @prompt accessToken
POST {{baseUrl}}/api/narocila/2/zavrnitev
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "razlog": "Za želeni termin nimamo razpoložljive mehanizacije."
}
