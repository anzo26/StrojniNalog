@baseUrl = http://localhost:5176

### Seznam dostopnih nalogov
# @prompt accessToken
GET {{baseUrl}}/api/delovni-nalogi
Authorization: Bearer {{accessToken}}
Accept: application/json


### Priprava delovnega naloga
# @prompt accessToken
POST {{baseUrl}}/api/delovni-nalogi
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "narociloId": 1,
  "strojId": 1,
  "izvajalecId": 3,
  "predvideniZacetek": "2026-11-10T08:00:00+01:00",
  "predvideniKonec": "2026-11-10T08:00:00+01:00"
}

### Podrobnosti delovnega naloga
# @prompt accessToken
GET {{baseUrl}}/api/delovni-nalogi/1
Authorization: Bearer {{accessToken}}
Accept: application/json


### Beleženje začetka dela
# @prompt accessToken
POST {{baseUrl}}/api/delovni-nalogi/1/zacetek
Authorization: Bearer {{accessToken}}

### Beleženje konca dela
# @prompt accessToken
POST {{baseUrl}}/api/delovni-nalogi/1/konec
Authorization: Bearer {{accessToken}}